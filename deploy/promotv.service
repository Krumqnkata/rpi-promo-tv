[Unit]
Description=PromoTV - video player, TV control and web panel
After=network.target NetworkManager.service sound.target
Wants=NetworkManager.service

[Service]
Type=simple
WorkingDirectory=/opt/promotv
ExecStart=/usr/bin/python3 -m promotv
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=/var/lib/promotv/tmp
RuntimeDirectory=promotv
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
